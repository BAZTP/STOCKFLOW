#!/usr/bin/env bash
set -euo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"
if ! docker container inspect stockflow-sqlserver >/dev/null 2>&1; then
 "$repo/bin/cloud-install"
fi
"$repo/bin/cloud-sqlserver"
"$repo/bin/cloud-php" php artisan migrate --seed --force
if docker container inspect stockflow-app >/dev/null 2>&1; then docker stop stockflow-app >/dev/null; fi
if docker container inspect stockflow-app-sqlserver >/dev/null 2>&1; then
 if [[ "$(docker inspect -f '{{.State.Running}}' stockflow-app-sqlserver)" != true ]]; then docker start stockflow-app-sqlserver >/dev/null; fi
else
 docker run -d --name stockflow-app-sqlserver --network stockflow --user "$(id -u):$(id -g)" \
  -p 127.0.0.1:8000:8000 --mount "type=bind,src=$repo,dst=/workspace/STOCKFLOW" \
  --mount type=bind,src=/workspace/cloud-runtime/sqlserver-tls/ca-bundle.crt,dst=/etc/ssl/certs/ca-certificates.crt,readonly \
  stockflow-php:sqlserver php artisan serve --host=0.0.0.0 --port=8000 >/dev/null
fi
for attempt in {1..30}; do
 if curl --silent --fail http://127.0.0.1:8000/login >/dev/null; then echo 'Aplicación y SQL Server disponibles; login respondió correctamente.'; exit 0; fi
 sleep 1
done
echo 'La aplicación no respondió correctamente; revisar docker logs stockflow-app-sqlserver.' >&2
exit 1
