#!/usr/bin/env bash
# Reproducible setup for the managed cloud machine; do not overwrite custom DB settings.
set -euo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo"
mkdir -p /workspace/.composer-cache /workspace/cloud-runtime
build_args=()
if [[ -n "${CODEX_PROXY_CERT:-}" ]]; then build_args+=(--secret "id=proxy_ca,src=$CODEX_PROXY_CERT"); fi
docker build "${build_args[@]}" -t stockflow-php:sqlserver docker
docker build "${build_args[@]}" -f docker/Dockerfile.sqlserver -t stockflow-sqlserver:2022 docker
bin/cloud-sqlserver
bin/cloud-php composer install --prefer-dist --no-interaction --no-progress
if rg -q '^APP_KEY=$' .env; then bin/cloud-php php artisan key:generate --force; fi
bin/cloud-php php artisan migrate --seed --force
if [[ ! -L public/storage ]]; then bin/cloud-php php artisan storage:link; fi
npm ci --no-audit --no-fund
npm run build
